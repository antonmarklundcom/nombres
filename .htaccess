# Hostinger Apache/LiteSpeed, PHP 8.2+. Deploy the branch to public_html.
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(?:www\.)?nombres\.com\.py$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://nombres.com.py%{REQUEST_URI} [R=301,L,NE]

# Only local public assets bypass PHP. Internals always render the 404 page.
RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [L]
RewriteRule ^assets/(?!.*(?:^|/)\.)[a-zA-Z0-9_/-]+\.(?:css|js|png|svg|webp|avif|woff2|txt)$ - [L]
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [END]
</IfModule>

<FilesMatch "(?i)\.(mjs|md|log|sh|lock|ya?ml|zip|bak|sql)$">
Require all denied
</FilesMatch>
<IfModule !mod_rewrite.c>
Require all denied
</IfModule>
<FilesMatch "^\.">
Require all denied
</FilesMatch>
<IfModule mod_mime.c>
AddType font/woff2 .woff2
AddType image/svg+xml .svg
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(css|js|png|svg|webp|avif|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/javascript text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
